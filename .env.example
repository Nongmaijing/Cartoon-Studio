# Copy this file to D:\bro\CartoonStudio\.env and fill in what you need.
# Never commit the real .env file.

# ---- OpenAI AI Director ----
# Required for the in-app AI Director and story/script generation.
# Use a model ID that is actually available to your OpenAI account.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOOL_ROUNDS=8
OPENAI_TIMEOUT_SECONDS=120

# ---- Cartoon Studio ----
CARTOON_STUDIO_BASE_URL=http://127.0.0.1:8010
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Optional database override. Leave blank to use config/config.json paths.
# CARTOON_STUDIO_DB_PATH=D:\bro\CartoonStudio\data\cartoon_studio.db
# DATABASE_URL=sqlite:///D:/bro/CartoonStudio/data/cartoon_studio.db
# REDIS_URL is reserved; Cartoon Studio deliberately keeps the existing SQLite queue.

# ---- MCP server ----
# MCP is a separate process on port 8020.
MCP_ENABLED=true
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8020
# Public HTTPS URL used for ChatGPT/custom connector + OAuth metadata.
# For local testing leave blank and use a tunnel URL when connecting remotely.
MCP_PUBLIC_URL=
# Bearer token for the MCP HTTP endpoint. Either set this or create a token
# through POST /api/v1/mcp/tokens. Store it securely.
MCP_BEARER_TOKEN=
MCP_AUTH_MODE=bearer

# ---- Generation providers ----
# Cloud generation is opt-in. Private assets are not uploaded automatically.
ALLOW_CLOUD_GENERATION=false
# Optional OpenAI image model for the cloud image provider.
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- Quality control ----
# Deterministic QC is always available. AI QC remains off unless explicitly enabled.
ENABLE_AI_QC=false
