{
  "schema": 1,
  "name": "SDXL inpainting (masked edit)",
  "description": "Masked SDXL edit using an inpainting checkpoint, VAEEncodeForInpaint and tiled VAE decoding.",
  "engine": "sdxl",
  "kind": "image",
  "supports_lora": true,
  "supports_vae": true,
  "low_vram": true,
  "roles": {
    "checkpoint": {
      "node": "4",
      "class": "CheckpointLoaderSimple",
      "input": "ckpt_name"
    },
    "positive_prompt": {
      "node": "6",
      "class": "CLIPTextEncode",
      "input": "text"
    },
    "negative_prompt": {
      "node": "7",
      "class": "CLIPTextEncode",
      "input": "text"
    },
    "width": {
      "node": "11",
      "class": "ImageScale",
      "input": "width"
    },
    "height": {
      "node": "11",
      "class": "ImageScale",
      "input": "height"
    },
    "seed": {
      "node": "3",
      "class": "KSampler",
      "input": "seed"
    },
    "steps": {
      "node": "3",
      "class": "KSampler",
      "input": "steps"
    },
    "cfg": {
      "node": "3",
      "class": "KSampler",
      "input": "cfg"
    },
    "sampler": {
      "node": "3",
      "class": "KSampler",
      "input": "sampler_name"
    },
    "scheduler": {
      "node": "3",
      "class": "KSampler",
      "input": "scheduler"
    },
    "denoise": {
      "node": "3",
      "class": "KSampler",
      "input": "denoise"
    },
    "filename_prefix": {
      "node": "9",
      "class": "SaveImage",
      "input": "filename_prefix"
    },
    "input_image": {
      "node": "10",
      "class": "LoadImage",
      "input": "image"
    },
    "mask_image": {
      "node": "12",
      "class": "LoadImageMask",
      "input": "image"
    }
  },
  "model_checks": [
    {
      "role": "checkpoint",
      "loader": "CheckpointLoaderSimple",
      "input": "ckpt_name"
    }
  ],
  "output_nodes": [
    "9"
  ]
}
